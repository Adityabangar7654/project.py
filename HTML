<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Animated Landing Page</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <style>
    .hero-button {
      transition: all 0.3s ease-in-out;
    }
  </style>
</head>
<body class="bg-gray-900 text-white">

  <!-- Navbar -->
  <nav class="fixed top-0 left-0 right-0 p-6 bg-gray-800 shadow-lg opacity-0 translate-y-[-50px]" id="navbar">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <h1 class="text-2xl font-bold">MyLanding</h1>
      <ul class="flex space-x-6">
        <li><a href="#" class="hover:text-green-400">Home</a></li>
        <li><a href="#" class="hover:text-green-400">About</a></li>
        <li><a href="#" class="hover:text-green-400">Contact</a></li>
      </ul>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="h-screen flex items-center justify-center text-center px-6">
    <div class="space-y-6">
      <h1 class="text-5xl font-extrabold fade-in-up">Welcome to the Future</h1>
      <p class="text-lg fade-in-up delay-1">Build blazing fast websites with smooth animations</p>
      <button class="bg-green-500 text-white px-6 py-3 rounded-lg text-lg font-semibold hero-button pulse">Get Started</button>
    </div>
  </section>

  <!-- Scroll Content -->
  <section class="min-h-screen bg-gray-800 flex items-center justify-center px-6">
    <div class="max-w-xl text-center fade-in-up">
      <h2 class="text-3xl font-bold mb-4">Scroll Animation</h2>
      <p class="text-gray-300">This content fades in when you scroll down thanks to GSAP ScrollTrigger.</p>
    </div>
  </section>

  <!-- GSAP + ScrollTrigger -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

  <script>
    // Navbar Slide-In
    gsap.to("#navbar", {
      opacity: 1,
      y: 0,
      duration: 1,
      ease: "power2.out"
    });

    // Button Pulse Animation
    gsap.to(".pulse", {
      scale: 1.1,
      repeat: -1,
      yoyo: true,
      ease: "power1.inOut",
      duration: 0.8
    });

    // Fade-in animations
    gsap.utils.toArray(".fade-in-up").forEach((elem, i) => {
      gsap.from(elem, {
        scrollTrigger: {
          trigger: elem,
          start: "top 85%",
        },
        opacity: 0,
        y: 30,
        duration: 1,
        delay: i * 0.2,
        ease: "power3.out"
      });
    });
  </script>
</body>
</html>
